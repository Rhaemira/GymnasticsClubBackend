DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=gymnastics_club
DATABASE_USERNAME=gymnastics_dev
DATABASE_PASSWORD=replace-this-local-password
DATABASE_TLS=disable
AUTH_TOKEN_TTL_SECONDS=43200
LOG_LEVEL=info
PORT=8080
# ADMIN_EMAIL and ADMIN_INITIAL_PASSWORD are prompted by Scripts/create-admin.sh; do not store them here.

# Keep false for native development. Compose explicitly enables this only for
# the unpublished PostgreSQL service on its private Docker bridge network.
# Externally reachable production databases must use DATABASE_TLS=require.
DATABASE_TLS_ALLOW_PRIVATE_COMPOSE_LINK=false
